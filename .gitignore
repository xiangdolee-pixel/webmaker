# 기획 원문 워드 파일은 공개 배포 대상이라 커밋하지 않는다
*.docx
*.doc

# 로컬 빌드 캐시
.wrangler/

# Workers 빌드 결과물(node build.mjs <폴더> 가 만든다)
/dist/
/.deploy/
/.deploy-*.wrangler.jsonc
/wrangler.jsonc

# 붙여넣기 원본(스크린샷·녹화) — 사이트가 참조하지 않는 참고자료
uploads/

# 고객 원본·업로드 자료(리포 밖 보관, 절대 커밋하지 않는다)
_src/
*-uploads/
**/docs/홈페이지작업/

# macOS 잡파일
.DS_Store

# 로컬 Pages Functions 비밀값
.dev.vars
.xim-connect.json

# roadbible: 성경 본문(개역개정 — 저작권 대한성서공회)은 공개 리포에 올리지 않는다. 배포는 로컬 파일로.
roadbible/bible-data.js
