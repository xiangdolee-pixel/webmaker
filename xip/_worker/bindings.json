{
  "xim": true,
  "placement": {
    "mode": "smart"
  },
  "assets": {
    "run_worker_first": [
      "/*",
      "!/css/*",
      "!/js/*",
      "!/img/*",
      "!/favicon.ico",
      "!/manifest.webmanifest"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "HUB",
        "class_name": "Hub"
      },
      {
        "name": "PREFS",
        "class_name": "Prefs"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Hub"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "Prefs"
      ]
    }
  ]
}
